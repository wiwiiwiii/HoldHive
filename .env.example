# HoldHive local environment

# Spring profile: local, test, demo
SPRING_PROFILES_ACTIVE=local

# Local MySQL used by the backend local profile
MYSQL_DATABASE=holdhive
MYSQL_USER=holdhive
MYSQL_PASSWORD=holdhive
MYSQL_ROOT_PASSWORD=holdhive_root
MYSQL_PORT=3306

# Backend
BACKEND_PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=holdhive
DB_USER=holdhive
DB_PASSWORD=holdhive

# Market data
HOLDHIVE_MARKET_EXTERNAL_ENABLED=true
HOLDHIVE_MARKET_CACHE_TTL=60s
HOLDHIVE_MARKET_HTTP_TIMEOUT=3s

# LLM / AI analysis
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
